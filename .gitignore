# Isolated runtime environments
.venv/
.venv-nbv/
.venv-mask/
# Python caches
**/__pycache__/
*.py[cod]
**/.pytest_cache/
# ROS build and runtime output
**/build/
**/install/
**/log/
perception_ws/build-*/
perception_ws/install-*/
perception_ws/log-*/
perception_ws/test-log-*/
/Log/
/results/
# Private/local model payload; manifest remains versioned
/config/models/*.pt
# Editor caches
.vscode/
.idea/
# Large sensor recordings
rosbag2_*/
*.bag
*.db3
*.mcap
# Local configuration and secrets
.env
.env.*
!.env.example
