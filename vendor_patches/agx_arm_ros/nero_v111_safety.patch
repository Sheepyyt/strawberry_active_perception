diff --git a/src/agx_arm_ctrl/test/test_safety_services.py b/src/agx_arm_ctrl/test/test_safety_services.py
new file mode 100644
index 0000000..89b3416
--- /dev/null
+++ b/src/agx_arm_ctrl/test/test_safety_services.py
@@ -0,0 +1,184 @@
+"""Regression tests for state-changing NERO ROS services."""
+
+from types import SimpleNamespace
+
+from agx_arm_ctrl.agx_arm_ctrl_single_node import AgxArmRosNode
+
+from pyAgxArm import NeroFW
+
+
+class _Logger:
+    """Collect log calls without constructing a ROS node."""
+
+    def __init__(self):
+        self.entries = []
+
+    def _record(self, level, message):
+        self.entries.append((level, message))
+
+    def info(self, message):
+        self._record('info', message)
+
+    def warn(self, message):
+        self._record('warn', message)
+
+    def error(self, message):
+        self._record('error', message)
+
+
+class _Arm:
+    """Minimal fake SDK arm exposing safety-relevant call counters."""
+
+    def __init__(self):
+        self.electronic_stop_calls = 0
+        self.move_j_calls = 0
+        self.move_js_calls = 0
+        self.stop_error = None
+
+    def electronic_emergency_stop(self):
+        self.electronic_stop_calls += 1
+        if self.stop_error is not None:
+            raise self.stop_error
+
+    def move_j(self, _q):
+        self.move_j_calls += 1
+
+    def move_js(self, _q):
+        self.move_js_calls += 1
+
+
+def _bare_node():
+    """Create only the attributes used by the callbacks under test."""
+    logger = _Logger()
+    arm = _Arm()
+    node = SimpleNamespace(
+        agx_arm=arm,
+        arm_type='nero',
+        arm_joint_count=7,
+        control_enabled=True,
+        enable_flag=True,
+        is_piper=False,
+        is_nero=True,
+        fw_version='v111',
+        is_switch_seamlessly=True,
+        is_mit_mode=False,
+        _control_gate_block_logged=True,
+        _emergency_stop_latched=False,
+        get_logger=lambda: logger,
+    )
+    node._request_electronic_emergency_stop = lambda: (
+        AgxArmRosNode._request_electronic_emergency_stop(node)
+    )
+    return node, arm, logger
+
+
+def test_emergency_stop_uses_only_sdk_electronic_stop():
+    """The stop service must not synthesize any joint motion command."""
+    node, arm, _logger = _bare_node()
+    response = object()
+
+    returned = AgxArmRosNode._emergency_stop_callback(
+        node, object(), response
+    )
+
+    assert returned is response
+    assert node.control_enabled is False
+    assert node._emergency_stop_latched is True
+    assert node._control_gate_block_logged is False
+    assert arm.electronic_stop_calls == 1
+    assert arm.move_j_calls == 0
+    assert arm.move_js_calls == 0
+
+
+def test_checked_stop_reports_failure_and_latches():
+    """Report a failed SDK call and keep the command gate shut."""
+    node, arm, _logger = _bare_node()
+    arm.stop_error = RuntimeError('CAN send failed')
+    response = SimpleNamespace(success=True, message='')
+
+    returned = AgxArmRosNode._checked_emergency_stop_callback(
+        node, object(), response
+    )
+
+    assert returned is response
+    assert response.success is False
+    assert 'CAN send failed' in response.message
+    assert node.control_enabled is False
+    assert node._emergency_stop_latched is True
+    assert arm.electronic_stop_calls == 1
+
+
+def test_latched_stop_rejects_reopening_control_gate():
+    """A new driver process is required before command flow can resume."""
+    node, _arm, _logger = _bare_node()
+    node.control_enabled = False
+    node._emergency_stop_latched = True
+    response = SimpleNamespace(success=True, message='')
+
+    returned = AgxArmRosNode._control_gate_callback(
+        node, SimpleNamespace(data=True), response
+    )
+
+    assert returned is response
+    assert response.success is False
+    assert node.control_enabled is False
+    assert 'latched' in response.message.lower()
+
+
+def test_enable_is_attempted_before_feedback_for_legacy_nero():
+    """Firmware 1.11 must be allowed to enable before CAN feedback starts."""
+    node, _arm, _logger = _bare_node()
+    enable_calls = []
+    node._check_arm_ready = lambda: False
+    node._enable_arm = lambda value: enable_calls.append(value) or True
+    request = SimpleNamespace(data=True)
+    response = SimpleNamespace(success=False, message='')
+
+    returned = AgxArmRosNode._enable_callback(node, request, response)
+
+    assert returned is response
+    assert enable_calls == [True]
+    assert response.success is True
+    assert response.message == 'Agx_arm enabled'
+
+
+def test_enable_without_feedback_is_rejected_for_nonlegacy_arm():
+    """Only the documented NERO v1.11 bootstrap may bypass feedback."""
+    node, _arm, _logger = _bare_node()
+    node.is_nero = False
+    node.fw_version = ''
+    node._check_arm_ready = lambda: False
+    enable_calls = []
+    node._enable_arm = lambda value: enable_calls.append(value) or True
+    request = SimpleNamespace(data=True)
+    response = SimpleNamespace(success=False, message='')
+
+    returned = AgxArmRosNode._enable_callback(node, request, response)
+
+    assert returned is response
+    assert enable_calls == []
+    assert response.success is False
+    assert 'no valid joint feedback' in response.message.lower()
+
+
+def test_v111_protocol_adapter_is_selected_before_connection():
+    """The explicit NERO 1.11 setting selects the matching SDK driver."""
+    node, _arm, _logger = _bare_node()
+
+    selected = AgxArmRosNode._driver_firmware_for_version(node, 111.0)
+
+    assert selected == NeroFW.V111
+
+
+def test_move_home_obeys_external_control_gate():
+    """The convenience home service cannot bypass a closed control gate."""
+    node, arm, _logger = _bare_node()
+    node.control_enabled = False
+    node._check_arm_ready = lambda: True
+
+    response = object()
+    returned = AgxArmRosNode._move_home_callback(node, object(), response)
+
+    assert returned is response
+    assert arm.move_j_calls == 0
+    assert arm.move_js_calls == 0
